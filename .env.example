# ==============================================================================
# Fever Dream Comedy — Frontend Environment Configuration Template
# Copy this file to .env.local and fill in values as needed.
# All variables are optional for local development; tracking no-ops when unset.
# ==============================================================================

# --- Marketing / Analytics (see docs/tracking.md) ---
# Google Tag Manager container id, e.g. GTM-XXXXXXX
VITE_GTM_CONTAINER_ID=

# GTM environment tokens (DEV / STAGING only).
# Leave BOTH empty in production: the published container IS production.
# Copy these from GTM → Admin → Environments → <env> → "Get Snippet".
VITE_GTM_ENV_AUTH=
VITE_GTM_ENV_PREVIEW=

# Meta Pixel id (loaded via GTM, not hard-coded in the app).
# >>> ADD YOUR PIXEL ID HERE <<< e.g. VITE_META_PIXEL_ID=123456789012345
# Find it in Meta Events Manager → Data Sources → your pixel → Settings.
# When unset, the pixel is a clean no-op. See README.md → "Meta Pixel setup".
VITE_META_PIXEL_ID=

# Set to "true" to log dataLayer pushes to the browser console
VITE_TRACKING_DEBUG=false
