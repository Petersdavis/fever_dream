rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public events are read-only to the world; only the sync Function
    // (Admin SDK, which bypasses these rules) may write them.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
